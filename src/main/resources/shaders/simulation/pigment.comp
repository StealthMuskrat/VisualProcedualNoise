#version 430 core
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D previousState;
layout(binding=1) uniform sampler2D flowTexture;
layout(rgba16f,binding=0) writeonly uniform image2D nextState;
uniform float dt,aspect,decay,injection;
uniform vec4 pointer;
uniform vec2 previousPointer;
uniform int recipe;
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),extent=imageSize(nextState);
    if(any(greaterThanEqual(pixel,extent)))return;
    vec2 uv=(vec2(pixel)+.5)/vec2(extent),units=vec2(2.*aspect,2.);
    vec2 velocity=texture(flowTexture,uv).xy;
    vec2 midpoint=uv-.5*dt*velocity/units;
    vec2 back=uv-dt*texture(flowTexture,midpoint).xy/units;
    vec4 old=texture(previousState,back);
    vec2 texel=1./vec2(extent);
    vec3 average=(texture(previousState,back+vec2(texel.x,0)).rgb+texture(previousState,back-vec2(texel.x,0)).rgb+texture(previousState,back+vec2(0,texel.y)).rgb+texture(previousState,back-vec2(0,texel.y)).rgb)*.25;
    vec3 pigment=mix(old.rgb,average,1.-exp(-.3*dt))*exp(-decay*dt);
    vec2 p=(uv*2.-1.)*vec2(aspect,1.),segment=pointer.xy-previousPointer;
    float along=clamp(dot(p-previousPointer,segment)/max(dot(segment,segment),1e-8),0.,1.);
    float brush=exp(-dot(p-previousPointer-along*segment,p-previousPointer-along*segment)/(pointer.z*pointer.z))*pointer.w;
    pigment+=dt*injection*brush*vec3(.3,1.,.6);
    if(recipe==11) {
        pigment+=dt*injection*(exp(-dot(p-vec2(-.5,.2),p-vec2(-.5,.2))/.015)*vec3(1.,.1,.02)
            +exp(-dot(p-vec2(.5,-.3),p-vec2(.5,-.3))/.015)*vec3(.02,.5,1.));
    }
    imageStore(nextState,pixel,vec4(clamp(pigment,0.,8.),min(old.a+dt,1000.)));
}
