#version 430 core
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D previousState;
layout(r32f,binding=0) writeonly uniform image2D nextState;
uniform float dt,aspect;
uniform vec4 pointer;
uniform uint seed;
#include "../common/noise.glsl"
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),extent=imageSize(nextState);
    if(any(greaterThanEqual(pixel,extent)))return;
    vec2 p=((vec2(pixel)+.5)/vec2(extent)*2.-1.)*vec2(aspect,1.);
    float rate=clamp(1.+.7*noise3d(vec3(p,.3)),.2,1.8);
    rate*=mix(1.,.1,pointer.w*exp(-dot(p-pointer.xy,p-pointer.xy)/(pointer.z*pointer.z)));
    imageStore(nextState,pixel,vec4(texelFetch(previousState,pixel,0).r+dt*rate,0,0,0));
}
