#version 430 core
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D previousState;
layout(binding=1) uniform sampler2D marks;
layout(binding=2) uniform sampler2D flowTexture;
layout(rgba16f,binding=0) writeonly uniform image2D nextState;
uniform float dt,memory,aspect;
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),extent=imageSize(nextState);
    if(any(greaterThanEqual(pixel,extent)))return;
    vec2 uv=(vec2(pixel)+.5)/vec2(extent);
    vec2 back=uv-dt*texture(flowTexture,uv).xy/vec2(2.*aspect,2.);
    float keep=exp(-mix(12.,.1,memory)*dt);
    vec3 value=mix(texture(marks,uv).rgb,texture(previousState,back).rgb,keep);
    imageStore(nextState,pixel,vec4(clamp(value,0.,16.),1));
}
