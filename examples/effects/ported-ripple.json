        "y": 60,
        "bypass": false,
        "group": "",
        "comment": "",
        "template": ""
      },
      {
        "id": "offset",
        "kind": "FORMULA",
        "inputs": [],
        "expression": ".1",
        "x": 60,
        "y": 60,
        "bypass": false,
        "group": "",
        "comment": "",
        "template": ""
      },
      {
        "id": "ripple",
        "kind": "GROUP",
        "inputs": [
          "warped",
          "offset"
        ],
        "expression": "0",
        "x": 60,
        "y": 60,
        "bypass": false,
        "group": "",
        "comment": "",
